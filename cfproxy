#!/bin/sh
# Runs cfproxy (src/*.ts) in its container. Only what has to happen on the host itself is here: starting the stack and
# keeping it up across reboots, exec'ing ssh, and opening a browser.
caller=$PWD # `cfproxy ssh` runs ssh from here, so relative paths in its arguments (-i ./key) work
cd "$(dirname "$(readlink -f "$0")")" || exit
# This host, for the container: compose.yaml passes these in and mounts $CFPROXY_BIN and ~/.ssh.
export CFPROXY_HOSTNAME="$(uname -n)" CFPROXY_DIR="$PWD" CFPROXY_BIN="${XDG_BIN_HOME:-$HOME/.local/bin}" \
  CFPROXY_OS="$(uname -s)" CFPROXY_ARCH="$(uname -m)" CFPROXY_PATH="$PATH"
mkdir -p "$CFPROXY_BIN" && mkdir -pm 700 "$HOME/.ssh" || exit

# Works with docker compose, podman-compose or `podman compose` (rootless included); CFPROXY_COMPOSE overrides.
if [ -n "$CFPROXY_COMPOSE" ]; then compose=$CFPROXY_COMPOSE
elif docker compose version >/dev/null 2>&1; then compose="docker compose"
elif command -v podman-compose >/dev/null; then compose=podman-compose
elif podman compose version >/dev/null 2>&1; then compose="podman compose"
else echo "cfproxy: need docker compose or podman-compose" >&2; exit 1; fi
# With a tty (no -T) Ctrl-C reaches the container itself instead of orphaning it; -T only when piped.
if [ -t 0 ]; then notty=; else notty=-T; fi
# Reuse the background container when it is up (`exec` is much faster than creating a container per command);
# otherwise fall back to a throwaway one. ./src is bind-mounted, so exec still runs the current code.
if $compose exec -T cfproxy true >/dev/null 2>&1; then run="$compose exec"; else run="$compose run --rm"; fi
daemon() { $run $notty cfproxy bun /app/daemon.ts "$@"; }

# Podman ignores `restart: unless-stopped` across reboots: containers only come back if podman-restart.service is
# enabled, and for rootless podman the user manager must also run without a login session (linger).
# Docker's daemon handles this itself, so only act when the engine is rootless podman.
survive_reboot() {
  command -v podman >/dev/null && command -v systemctl >/dev/null || return 0
  [ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = true ] || return 0
  systemctl --user is-enabled -q podman-restart.service 2>/dev/null ||
    systemctl --user enable -q podman-restart.service ||
    echo "cfproxy: could not enable podman-restart.service; the tunnel will not come back after a reboot" >&2
  me=$(id -un)
  [ "$(loginctl show-user "$me" -p Linger --value 2>/dev/null)" = yes ] || loginctl enable-linger "$me" 2>/dev/null || {
    echo "cfproxy: enabling linger needs root, running: sudo loginctl enable-linger $me" >&2
    sudo loginctl enable-linger "$me"
  } || echo "cfproxy: linger not enabled; the tunnel will only start after you log in" >&2
}

# Sync Cloudflare, then run the stack in the background, also after reboots.
# --force-recreate: ./src is bind-mounted, so without it the daemon would keep running the code it started with.
start() {
  daemon apply && $compose up -d --force-recreate cfproxy && $compose up -d && survive_reboot &&
    echo "cfproxy: running in the background, restarts after reboot (./cfproxy status to check)"
}

# These recreate the background container, so they must not run in it: it may predate the current compose.yaml.
case "$#:$1" in 1:apply | 1:run | 1:install) run="$compose run --rm" ;; esac

case "$#:$1" in
  0:) daemon help ;;
  # The foreground loop (`run`) belongs to the background container: started from here, Ctrl-C would leave it
  # running next to the real daemon. So `run` means apply here.
  1:apply | 1:run) start ;;
  # Without a token (skipped: a machine that only uses cfproxy ssh) there is nothing to serve, so nothing to start.
  1:install) daemon install && if grep -qs '^ *api_token: *[^ ]' config/.secrets.yml; then start; fi ;;
  # The container sets up ~/.ssh/config for the destination; ssh itself runs here, from where cfproxy was called.
  *:ssh) daemon "$@" && shift && cd "$caller" && exec ssh "$@" ;;
  # The browser opens from here (the container has none); the container checks the price and waits.
  2:buy)
    # -T: no pty, so the captured URL has no carriage return.
    if url=$($run -T cfproxy bun /app/daemon.ts buyurl "$2" 2>/dev/null); then
      if command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1 &
      elif command -v open >/dev/null; then open "$url" >/dev/null 2>&1 &
      fi
    fi
    daemon buy "$2" ;;
  *) daemon "$@" ;;
esac
